# Django Environment Variables
DEBUG=True
SECRET_KEY=change-me-to-a-secure-random-key-in-production
ALLOWED_HOSTS=127.0.0.1,localhost

# Database Configuration (leave empty for SQLite in dev, or specify postgres URL)
# Example: postgres://username:password@localhost:5432/portfolio_db
DATABASE_URL=

# CORS Configuration (Frontend origins allowed to make requests)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Email Notification Settings (for contact form submissions)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=portfolio@example.com
CONTACT_NOTIFICATION_EMAIL=hilpatelss@gmail.com

# Anti-Spam / Rate Limiting
CONTACT_RATE_LIMIT=5/hour
HONEYPOT_FIELD_NAME=website

