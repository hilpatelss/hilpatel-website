# Django Environment Variables
DEBUG=False
SECRET_KEY=change-me-to-a-secure-random-key-in-production
ALLOWED_HOSTS=127.0.0.1,localhost,api.hilpatel.site,.onrender.com

# Database Configuration
# Leave empty for SQLite in dev (DEBUG=True).
# In production (DEBUG=False), provide your Neon PostgreSQL connection string:
# Example: postgresql://neondb_owner:YOUR_PASSWORD@ep-xyz-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Superuser initialization on deployment (optional, Render Free friendly)
CREATE_ADMIN_ON_DEPLOY=false
ADMIN_USERNAME=admin
ADMIN_EMAIL=hilpatelss@gmail.com
ADMIN_PASSWORD=

# CORS Configuration (Frontend origins allowed to make requests)
CORS_ALLOWED_ORIGINS=https://hilpatel.site,https://www.hilpatel.site,http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# CSRF Trusted Origins (Required for Django 4+ with HTTPS admin & forms)
CSRF_TRUSTED_ORIGINS=https://hilpatel.site,https://www.hilpatel.site,https://api.hilpatel.site

# Email Notification Settings (for contact form submissions)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=portfolio@example.com
CONTACT_NOTIFICATION_EMAIL=hilpatelss@gmail.com

# Anti-Spam / Rate Limiting
CONTACT_RATE_LIMIT=15/hour
HONEYPOT_FIELD_NAME=website
